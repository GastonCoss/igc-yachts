# --- Base de données (Supabase > Project Settings > Database > Connection string > "Session pooler") ---
DATABASE_URL=postgresql://postgres.xxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# --- Clé secrète de l'admin (n'importe quelle longue chaîne aléatoire, à garder secrète) ---
PAYLOAD_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# --- Stockage des photos (Supabase > Storage > S3 Connection) ---
# Laisse vide en local : les photos seront alors enregistrées dans le dossier /media du projet.
# Obligatoire en ligne (Vercel n'a pas de disque permanent).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
